# Dependencies
node_modules/

# Build output
dist/
web/dist/

# Local config & secrets — never commit (.env.example is the template)
.env

# Runtime data (private: conversations + fetched content)
sessions/
fetches/
agent_memory/
media/

# Standalone Python side-projects kept in-tree (not part of the pipeline)
# mdstrip: old standalone markdown-strip tool, kept for its history
mdstrip/
# temp_convert: toy Celsius↔Fahrenheit project, used as a shakedown fixture
temp_convert/

# Pi pipeline state
.pi/

# Logs / OS cruft
*.log
.DS_Store

# Scratch workspaces & UI prototypes (throwaway, not part of the product)
workspace/shakedown*/
web/prototype/
